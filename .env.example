# Copiare in .env (escluso da git) e compilare. Gli script Node lo leggono con: node --env-file=.env tools/<script>.mjs
# Il gioco sulla TV NON legge questo file: le chiavi stanno solo sul PC e nei segreti del Worker Cloudflare.

# --- Generazione e verifica delle domande (PLAN.md §4 "Domande") ---
GEMINI_API_KEY=            # https://aistudio.google.com/apikey (piano gratuito) — generatore
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=        # https://openrouter.ai/keys — verificatore (modello diverso dal generatore)
OPENROUTER_MODEL=          # un modello ":free" attivo, es. deepseek/deepseek-chat-v3-0324:free (cambiano spesso)
QUIZZONE_MOCK=1            # 1 = gli script usano le risposte finte in tools/fixtures/, nessuna chiamata alle IA

# --- Foto Misteriosa (G3) ---
PIXABAY_API_KEY=           # https://pixabay.com/api/docs/
FREESOUND_API_KEY=         # https://freesound.org/apiv2/apply (solo la chiave: ricerca + anteprime mp3, effetti CC0)

# --- Voce del presentatore ---
ELEVENLABS_API_KEY=        # oggi è anche una variabile utente di Windows

# --- Cloudflare Worker (server/) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=      # permessi: Workers Scripts + D1 (edit)
QUIZZONE_ADMIN_TOKEN=      # password del pannello admin del Worker (stringa lunga casuale)
QUIZZONE_API_URL=http://127.0.0.1:8787   # mock locale; poi https://<nome>.<account>.workers.dev
